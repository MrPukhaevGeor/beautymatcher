generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MODEL
  PROVIDER
  ADMIN
}

enum ProviderType {
  SCHOOL
  COLLEGE
  ACADEMY
  SALON
  PRIVATE_MASTER
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ServiceKind {
  HAIRCUT
  COLORING
  STYLING
  MANICURE
  PEDICURE
  BROWS
  LASHES
  MAKEUP
}

enum PriceMode {
  FREE
  MATERIALS_ONLY
}

enum ApplicationStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum LoginChannel {
  EMAIL
  PHONE
}

model User {
  id          String    @id @default(cuid())
  role        Role      @default(MODEL)
  name        String
  email       String?   @unique
  phone       String?   @unique
  vkId        String?   @unique
  yandexId    String?   @unique
  isAdult     Boolean   @default(false)
  blocked     Boolean   @default(false)
  isDemo      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  provider     Provider?
  applications Application[]
  reviews      Review[]
}

model Provider {
  id          String           @id @default(cuid())
  userId      String           @unique
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ProviderType
  title       String
  slug        String           @unique
  description String           @default("")
  district    String
  metro       String?
  address     String
  contact     String
  status      ModerationStatus @default(PENDING)
  isDemo      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  offers Offer[]

  @@index([status])
}

model Offer {
  id          String           @id @default(cuid())
  providerId  String
  provider    Provider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service     ServiceKind
  title       String
  description String           @default("")
  priceMode   PriceMode
  // Доплата за материалы, ₽. Заполняется только при MATERIALS_ONLY.
  materialsFrom Int?
  status      ModerationStatus @default(PENDING)
  isDemo      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  slots Slot[]

  @@index([status, service])
}

model Slot {
  id        String   @id @default(cuid())
  offerId   String
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  capacity  Int      @default(1)

  applications Application[]

  @@index([offerId, startsAt])
}

model Application {
  id        String            @id @default(cuid())
  slotId    String
  slot      Slot              @relation(fields: [slotId], references: [id], onDelete: Cascade)
  modelId   String
  model     User              @relation(fields: [modelId], references: [id], onDelete: Cascade)
  status    ApplicationStatus @default(PENDING)
  comment   String            @default("")
  // Путь к сжатому фото волос внутри папки uploads. В демо-режиме пусто.
  photoPath String?
  ageConfirmed Boolean        @default(false)
  isDemo    Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  review Review?

  @@unique([slotId, modelId])
  @@index([slotId, status])
}

model Review {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  rating        Int
  text          String      @default("")
  hidden        Boolean     @default(false)
  createdAt     DateTime    @default(now())
}

model LoginCode {
  id        String       @id @default(cuid())
  channel   LoginChannel
  target    String
  codeHash  String
  attempts  Int          @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([target, createdAt])
}
