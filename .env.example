# Копия этого файла называется .env и в репозиторий не попадает.
DATABASE_URL="postgresql://matcher:matcher_dev_only@localhost:15432/matcher"

# true = демо-режим: настоящие данные не собираются, индексация запрещена.
DEMO_MODE="true"

# Секрет для вызова ночного сброса демо-данных (/api/cron/reset). Без него маршрут отвечает 401.
# На Vercel Cron передаёт его сам. Сгенерируйте длинный случайный: openssl rand -base64 32
CRON_SECRET=""

# Секрет для подписи сессий. Для продакшена сгенерируйте новый: openssl rand -base64 32
SESSION_SECRET="dev-only-change-me-dev-only-change-me"

# Публичный адрес сайта (для ссылок в письмах и sitemap)
SITE_URL="http://localhost:3000"

# Почта (SMTP). Пусто = письма пишутся в журнал сервера.
SMTP_URL=""
MAIL_FROM="Красота рядом <no-reply@example.invalid>"

# Вход через VK и Яндекс. Пока пусто, кнопки показывают, что вход не настроен.
VK_CLIENT_ID=""
VK_CLIENT_SECRET=""
YANDEX_CLIENT_ID=""
YANDEX_CLIENT_SECRET=""
