# Копия этого файла на сервере называется .env.production. В репозиторий она не попадает.
# Сгенерируйте свои значения: пароль и секрет НЕ копируйте отсюда.

# Домен сайта без https://, например demo.example.ru. DNS-запись должна вести на сервер.
SITE_DOMAIN=
# Полный адрес сайта, например https://demo.example.ru
SITE_URL=

# Пароль базы данных (длинный случайный) и секрет сессий (openssl rand -base64 32)
POSTGRES_PASSWORD=
SESSION_SECRET=

# true = демо-режим (настоящие данные не собираются). На false переходят только после юридического оформления.
DEMO_MODE=true

# Почта для писем (SMTP). Пока пусто, письма не отправляются.
SMTP_URL=
MAIL_FROM=
